MEMORY_GATEWAY_HOST=0.0.0.0
MEMORY_GATEWAY_PORT=9443
MEMORY_GATEWAY_DB=/var/lib/memory-gateway/gateway.sqlite
MEMORY_GATEWAY_CLIENTS=/etc/memory-gateway/clients.json
MEMORY_GATEWAY_OPENAPI_DIR=/var/lib/memory-gateway/openapi
MEMORY_GATEWAY_TLS_KEY=/etc/memory-gateway/server.key
MEMORY_GATEWAY_TLS_CERT=/etc/memory-gateway/server.crt
MEMORY_GATEWAY_TLS_CA=/etc/memory-gateway/ca.crt
COGNEE_BASE_URL=http://127.0.0.1:8000
COGNEE_SEARCH_TYPE=CHUNKS
COGNEE_ADD_TIMEOUT_MS=60000
COGNEE_COGNIFY_TIMEOUT_MS=600000
COGNEE_SEARCH_TIMEOUT_MS=300000
COGNEE_VISUALIZATION_TIMEOUT_MS=60000
