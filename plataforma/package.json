{
  "name": "plataforma-orquestador",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc && vite build",
    "build:api": "tsc",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "migrate": "node --experimental-strip-types src/cli.ts migrate",
    "admin": "node --experimental-strip-types src/cli.ts admin",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "worker": "node --experimental-strip-types src/worker-main.ts"
  },
  "dependencies": { "fastify": "^5.8.0", "pg": "^8.16.3", "vue": "^3.5.42" },
  "devDependencies": { "@types/node": "^24.0.0", "@types/pg": "^8.15.5", "typescript": "^5.9.3", "vite": "^8.2.2", "@vitejs/plugin-vue": "^6.0.8" }
}
