#!/usr/bin/env bash
set -euo pipefail

argumentos=("$@")
cantidad="${#argumentos[@]}"
origen="${argumentos[$((cantidad - 2))]}"
destino="${argumentos[$((cantidad - 1))]}"
ruta_remota="${destino#*:}"
ruta_remota="$FAKE_REMOTE_ROOT$ruta_remota"

mkdir -p "$ruta_remota"
/bin/cp -R "$origen/." "$ruta_remota/"
